<?xml version="1.0" encoding="utf-8"?>
<!--
  Package manifest of the UWP player (docs/XBOX.md). build.ps1 fills the @...@ words.
  Identity name, display names and publisher are PLACEHOLDERS: the owner decides the real ones (docs/XBOX.md "Names").
  Publisher must equal the subject of the signing certificate (the local TEST certificate, tools/uwp/build.ps1).
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap">
  <Identity Name="@IDENTITY_NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>OpenTactics Player</DisplayName>
    <PublisherDisplayName>OpenTacticsEngine</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <!-- Windows.Universal: one package installs on PCs and on Xbox. 10.0.17763 (version 1809) is older than every
         Xbox OS that has Dev Mode UWP support worth using and newer than SDL2's own minimum (10.0.16299). -->
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    <!-- The Visual C++ runtime for UWP (/MD): a framework package, not part of this package. On Xbox it has to be
         installed once through the Device Portal, before this app (docs/XBOX.md). -->
    <PackageDependency Name="Microsoft.VCLibs.140.00" MinVersion="14.0.30035.0"
                       Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>
  <Resources>
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="ote-player.exe" EntryPoint="ote_player.App">
      <uap:VisualElements DisplayName="OpenTactics Player"
                          Description="The OpenTacticsEngine game player"
                          BackgroundColor="#1F2A44"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1F2A44" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <!-- No capabilities: the player needs no network, no libraries, no devices. Gamepad and keyboard input and audio
       playback need none. Saves go to the app's own LocalState folder. -->
</Package>
