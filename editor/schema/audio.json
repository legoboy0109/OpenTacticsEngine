        "files": { "type": "list", "min": 1, "excludes": ["file"], "of": { "type": "string" }, "help": "Several files: one is picked each time (1 to 16)." },
        "volume": { "type": "int", "min": 0, "max": 100, "help": "Percent of full volume (default 100)." } } } },
      "use": { "type": "object", "block": true, "help": "The game's standard set: which track plays where and which sound goes with which event.", "fields": {
