{
  "title": "Audio",
  "files": ["data/audio.json"],
  "root": {
    "type": "object",
    "fields": {
      "music": { "type": "map", "free": true, "help": "Music tracks by id (letters, digits, _ and -). Story commands, maps and the standard set below name them.", "of": { "type": "object", "fields": {
        "file": { "type": "string", "required": true, "help": "Path inside the game folder to an .ogg or .wav file, such as audio/title.ogg." },
        "loopStart": { "type": "number", "min": 0, "help": "Seconds into the track where the loop begins (default 0)." },
        "volume": { "type": "int", "min": 0, "max": 100, "help": "Percent of full volume (default 100)." },
        "loop": { "type": "bool", "default": true, "help": "false: plays once (a jingle: victory, defeat, level up ...)." } } } },
      "sounds": { "type": "map", "free": true, "help": "Sound effects by id. Units, weapons, items and story commands name them.", "of": { "type": "object", "fields": {
