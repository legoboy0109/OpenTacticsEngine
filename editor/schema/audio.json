        "mapMusic": { "type": "ref", "ref": "keys:@music", "values": [""], "help": "During a battle, when nothing more specific is set." },
        "playerTurnMusic": { "type": "ref", "ref": "keys:@music", "values": [""], "help": "While a person's side plays." },
        "enemyTurnMusic": { "type": "ref", "ref": "keys:@music", "values": [""], "help": "While the computer's sides play." },
        "sceneMusic": { "type": "ref", "ref": "keys:@music", "values": [""], "help": "Story scenes." },
        "prepMusic": { "type": "ref", "ref": "keys:@music", "values": [""], "help": "The preparation screen." },
        "shopMusic": { "type": "ref", "ref": "keys:@music", "values": [""], "help": "Shops." },
        "victory": { "type": "ref", "ref": "keys:@music", "values": [""], "help": "Jingle when the battle is won (the track needs loop: false)." },
        "defeat": { "type": "ref", "ref": "keys:@music", "values": [""], "help": "Jingle when the battle is lost (loop: false)." },
        "levelUp": { "type": "ref", "ref": "keys:@music", "values": [""], "help": "Jingle on a level up (loop: false)." },
        "promotion": { "type": "ref", "ref": "keys:@music", "values": [""], "help": "Jingle on a promotion (loop: false)." },
        "chapterCard": { "type": "ref", "ref": "keys:@music", "values": [""], "help": "Jingle of the chapter title card (loop: false)." },
        "bootJingle": { "type": "ref", "ref": "keys:@music", "values": [""], "help": "Jingle when the game starts (loop: false)." },
        "phaseMusic": { "type": "map", "free": true, "of": { "type": "ref", "ref": "keys:@music", "values": [""] }, "help": "Music by side id: the track that plays during that side's turn." },
        "fewEnemies": { "type": "object", "block": true, "help": "Another track once few enemies are left.", "fields": {
          "music": { "type": "ref", "ref": "keys:@music", "required": true, "help": "The track." },
          "count": { "type": "int", "required": true, "min": 1, "max": 999, "help": "It starts when this many hostile units or fewer remain." } } },
        "promotionSounds": { "type": "list", "min": 1, "help": "Sounds played at times after a promotion starts (1 to 16).", "of": { "type": "object", "fields": {
          "atMs": { "type": "int", "required": true, "min": 0, "max": 60000, "help": "Milliseconds after the start." },
          "sound": { "type": "ref", "ref": "keys:@sounds", "required": true, "help": "The sound." } } } },
        "sounds": { "type": "object", "help": "The sound that goes with each event of the game.", "fields": {
          "cursor": { "type": "ref", "ref": "keys:@sounds", "values": [""], "help": "The cursor moves." },
