          "heal": { "type": "ref", "ref": "keys:@sounds", "values": [""], "help": "Hit points are restored." },
          "defeated": { "type": "ref", "ref": "keys:@sounds", "values": [""], "help": "A unit is defeated." },
          "capture": { "type": "ref", "ref": "keys:@sounds", "values": [""], "help": "A structure is captured." },
          "build": { "type": "ref", "ref": "keys:@sounds", "values": [""], "help": "A unit or structure is built." },
          "itemUse": { "type": "ref", "ref": "keys:@sounds", "values": [""], "help": "An item is used." },
          "gold": { "type": "ref", "ref": "keys:@sounds", "values": [""], "help": "Funds change." },
          "dialogue": { "type": "ref", "ref": "keys:@sounds", "values": [""], "help": "A line of dialogue appears." },
          "turnStart": { "type": "ref", "ref": "keys:@sounds", "values": [""], "help": "A turn starts." },
          "upgrade": { "type": "ref", "ref": "keys:@sounds", "values": [""], "help": "A structure is upgraded." },
          "research": { "type": "ref", "ref": "keys:@sounds", "values": [""], "help": "A technology is finished." },
          "repair": { "type": "ref", "ref": "keys:@sounds", "values": [""], "help": "A unit is repaired." },
          "supply": { "type": "ref", "ref": "keys:@sounds", "values": [""], "help": "A unit is resupplied." },
          "ambush": { "type": "ref", "ref": "keys:@sounds", "values": [""], "help": "A hidden unit is found." },
          "select": { "type": "ref", "ref": "keys:@sounds", "values": [""], "help": "A unit is selected." },
          "levelUpTick": { "type": "ref", "ref": "keys:@sounds", "values": [""], "help": "A stat ticks up on the level-up screen." },
          "save": { "type": "ref", "ref": "keys:@sounds", "values": [""], "help": "The game is saved." } } } } }
    }
  }
