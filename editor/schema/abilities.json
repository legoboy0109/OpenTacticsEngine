{
  "files": ["data/abilities.json"],
  "rows": {
    "type": "object",
    "fields": {
      "id": { "type": "string", "required": true, "help": "Unique id; unit types, jobs and skills list it." },
      "name": { "type": "string", "help": "Display name (defaults to the id)." },
      "description": { "type": "string", "help": "Text shown in the menu." },
      "target": { "type": "enum", "values": ["self", "ally", "enemy", "unit", "cell"], "help": "Whom or what it is used on (required, except for a strike: it comes from the weapon)." },
      "range": { "type": "list", "length": 2, "of": { "type": "int", "min": 1, "max": 20, "sample": 1 }, "sample": [1, 2], "help": "[min, max] distance (1 to 20); not for self or a strike (the weapon has it)." },
      "effect": { "type": "variant", "help": "What it does (exactly one of these). May be left out only when there is an inflict.", "variants": [
        { "name": "push", "key": "push", "node": { "type": "object", "fields": { "push": { "type": "int", "required": true, "min": 1, "max": 5, "help": "Squares the target is pushed away." } } } },
        { "name": "pull", "key": "pull", "node": { "type": "object", "fields": { "pull": { "use": "_skills#flag", "help": "Pulls the target next to the user." } } } },
        { "name": "swap", "key": "swap", "node": { "type": "object", "fields": { "swap": { "use": "_skills#flag", "help": "Trades places with the target." } } } },
        { "name": "moveBehind", "key": "moveBehind", "node": { "type": "object", "fields": { "moveBehind": { "use": "_skills#flag", "help": "Steps back and draws the target after it." } } } },
        { "name": "movePast", "key": "movePast", "node": { "type": "object", "fields": { "movePast": { "use": "_skills#flag", "help": "Moves past the target." } } } },
        { "name": "heal", "key": "heal", "node": { "type": "object", "fields": { "heal": { "type": "variant", "required": true, "help": "Hit points restored (1 to 999, full, a percent of the maximum, or a formula: a = the user, b = the unit healed).", "variants": [
          { "name": "amount", "kind": "number", "node": { "type": "int", "min": 1, "max": 999 } }, { "name": "full", "value": "full" },
          { "name": "formula", "kind": "string", "node": { "type": "string" }, "sample": "a.mag * 3" },
          { "name": "percent", "key": "percent", "node": { "type": "object", "fields": { "percent": { "type": "int", "required": true, "min": 1, "max": 100, "help": "Percent of the maximum (at least 1 point)." } } } } ] } } } },
        { "name": "strike", "key": "strike", "node": { "type": "object", "fields": { "strike": { "type": "ref", "ref": "data/weapons.json", "required": true, "help": "Attacks with this weapon (a spell, a breath ...). Leave out target and range; cost must be action; the weapon must not charge." } } } },
        { "name": "summon", "key": "summon", "node": { "type": "object", "fields": { "summon": { "type": "object", "required": true, "help": "Calls a unit onto an empty square.", "fields": {
          "type": { "type": "ref", "ref": "data/units.json", "required": true, "help": "The unit type that appears." },
          "level": { "type": "variant", "help": "The summoner's level, or a fixed level.", "variants": [
            { "name": "summoner's level", "value": "summoner" }, { "name": "fixed level", "kind": "number", "node": { "type": "int", "min": 1, "max": 99 } } ] },
          "limit": { "type": "int", "min": 1, "max": 20, "help": "Most summoned units alive at once." },
          "lifetime": { "type": "int", "min": 0, "max": 99, "help": "Turns it stays (0 = until defeated)." },
          "vanish": { "type": "bool", "help": "It vanishes when the summoner is defeated." },
          "canAct": { "type": "bool", "help": "It may act on the turn it appears." },
          "givesXp": { "type": "bool", "help": "Defeating it gives experience." },
          "replace": { "type": "bool", "help": "When at the limit, the oldest one is replaced." },
          "pick": { "type": "enum", "values": ["highest", "random"], "help": "Which item candidate it carries (needs items)." },
          "items": { "type": "list", "help": "Candidate items it may carry (1 to 32).", "of": { "type": "object", "fields": {
            "item": { "type": "ref", "ref": "data/items.json", "help": "The item (leave out for no item)." },
            "minLevel": { "type": "int", "min": 1, "max": 99, "help": "Lowest level it is offered at." },
            "maxLevel": { "type": "int", "min": 1, "max": 99, "help": "Highest level it is offered at." },
            "weight": { "type": "int", "min": 1, "max": 1000, "help": "Chance weight when picking at random." } } } } } } } } },
        { "name": "unlock", "key": "unlock", "node": { "type": "object", "fields": { "unlock": { "type": "variant", "required": true, "help": "Opens a door or chest.", "variants": [
          { "name": "any lock", "value": true },
          { "name": "these kinds", "kind": "array", "node": { "type": "list", "of": { "type": "enum", "values": ["door", "chest"] } } },
          { "name": "kinds and key item", "key": "kinds", "node": { "type": "object", "fields": {
            "kinds": { "type": "list", "of": { "type": "enum", "values": ["door", "chest"] }, "help": "Which locks." },
            "needs": { "type": "ref", "ref": "data/items.json", "help": "An item the user must carry." } } } },
          { "name": "key item only", "key": "needs", "node": { "type": "object", "fields": {
            "kinds": { "type": "list", "of": { "type": "enum", "values": ["door", "chest"] }, "help": "Which locks." },
            "needs": { "type": "ref", "ref": "data/items.json", "help": "An item the user must carry." } } } } ] } } } },
        { "name": "steal", "key": "steal", "node": { "type": "object", "fields": { "steal": { "type": "variant", "required": true, "help": "Takes an item from a neighbour.", "variants": [
          { "name": "plain", "value": true },
          { "name": "with options", "kind": "object", "sample": { "if": "1", "weapons": true }, "node": { "type": "object", "fields": {
            "if": { "type": "string", "sample": "1", "help": "Formula (a = the user, b = the foe) that must be true." },
            "reason": { "type": "string", "help": "Why an item is greyed out (needs if)." },
            "weapons": { "type": "bool", "help": "Weapons may be taken." },
            "equipped": { "type": "bool", "help": "The equipped item may be taken." } } } } ] } } } },
        { "name": "refresh", "key": "refresh", "node": { "type": "object", "fields": { "refresh": { "type": "variant", "required": true, "help": "Lets an ally act again.", "variants": [
          { "name": "once", "value": true },
          { "name": "per turn", "key": "perTurn", "node": { "type": "object", "fields": { "perTurn": { "type": "int", "required": true, "min": 1, "max": 9, "help": "Allies refreshed per turn." } } } } ] } } } },
        { "name": "cure", "key": "cure", "node": { "type": "object", "fields": { "cure": { "use": "_common#cureList", "required": true, "help": "Conditions removed." } } } } ] },
      "cost": { "type": "enum", "values": ["action", "free"], "help": "action: ends the unit's action; free: costs nothing." },
      "spend": { "type": "map", "ref": ["game.json#resources", "game.json#unitResources"], "of": { "type": "int", "min": 1, "max": 999, "sample": 1 }, "help": "What using it costs: unit resources (MP and the like) or side resources, 1 to 999 each." },
      "uses": { "type": "int", "min": 1, "max": 99, "help": "Uses per battle." },
      "cooldown": { "type": "int", "min": 1, "max": 99, "help": "Turns before it can be used again." },
      "afterMove": { "type": "bool", "help": "Can be used after moving." },
      "spendsItem": { "type": "bool", "help": "Using it uses up an item use." },
      "xp": { "type": "variant", "help": "Experience for using it: a number (0 to 1000) or a formula (a = the user, b = the target).", "variants": [
        { "name": "number", "kind": "number", "node": { "type": "int", "min": 0, "max": 1000 } },
        { "name": "formula", "kind": "string", "node": { "type": "string" }, "sample": "1" } ] },
      "inflict": { "use": "_common#inflictAbility", "help": "A condition it puts on the target, with an optional chance." },
      "if": { "type": "list", "of": { "use": "_skills#condition" }, "help": "Conditions the target must meet (at most 8)." },
      "chargeSpeed": { "type": "int", "min": 1, "max": 1000, "help": "Makes it a charged action (needs turnOrder speed and cost action)." },
      "chargeTargets": { "type": "enum", "values": ["unit", "cell"], "help": "unit: follows the unit; cell: hits the square (needs chargeSpeed)." },
      "interruptedBy": { "type": "list", "of": { "type": "ref", "ref": "data/conditions.json" }, "help": "Conditions that cancel the charge (needs chargeSpeed)." }
    }
  }
}
