{
  "formatVersion": 1,
  "name": "Strategy RPG",
  "description": "A small strategy-RPG skirmish: named heroes, experience and level-ups.",
  "view": { "width": 480, "height": 270, "tileSize": 24 },
  "stats": [
    { "id": "hp", "name": "HP" },
    { "id": "str", "name": "Strength" },
    { "id": "skl", "name": "Skill" },
    { "id": "spd", "name": "Speed" },
    { "id": "def", "name": "Defense" },
    { "id": "mov", "name": "Move" }
  ],
  "roles": { "hp": "hp", "move": "mov" },
  "moveTypes": [
    { "id": "foot", "name": "Foot" },
    { "id": "horse", "name": "Horse" }
  ],
  "rules": {
    "turnOrder": "sides",
    "counterAttacks": true,
    "defeat": ["noUnits", "leaderDead"],
    // Units carry up to three things (data/items.json); weapons stay fixed per unit type.
    "items": { "weapons": "fixed", "inventorySize": 3 },
    // Pair up (docs/SRPG.md section 5): a unit can join a neighbour and stand behind it, adding its bonus. The demo uses "carry".
    "rescue": { "mode": "pairUp", "pairBonus": { "str": 1, "def": 1 } },
    "progression": {
      "enabled": true,
      "xpPerLevel": 100,
      "maxLevel": 20,
      "xpHit": "10 + math.max(0, b.level - a.level) * 3",
      "xpKill": "40 + math.max(0, b.level - a.level) * 10"
    }
  },
  "formulas": {
    "damage": "(a.str + w.might) - b.def - (tb.defense or 0)",
    "hit": "w.hit + a.skl * 2 - b.spd * 2 - (tb.avoid or 0)",
    "crit": "a.skl / 2",
    "critMultiplier": 3,
    "strikes": "(a.spd - b.spd >= 4) and 2 or 1"
  },
  "styles": [
    { "id": "classic", "name": "Classic" },
    { "id": "isometric", "name": "Isometric", "view": "isometric", "background": "#161a24" }
  ],
  "scripts": [],
  "maps": [
    { "id": "ford", "name": "The Ford", "file": "maps/ford.json" }
  ]
}
