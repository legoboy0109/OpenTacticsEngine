// Advance Wars-style demo: capture cities, earn funds, build units.
{
  "formatVersion": 1,
  "name": "Wars Demo",
  "view": { "width": 480, "height": 270, "tileSize": 24 },

  "stats": [
    { "id": "hp",  "name": "HP" },
    { "id": "mov", "name": "Move" }
  ],
  "roles": { "hp": "hp", "move": "mov" },
  "resources": [ { "id": "funds", "name": "Funds" } ],

  "moveTypes": [
    { "id": "foot",   "name": "Foot" },
    { "id": "tread",  "name": "Tread" },
    { "id": "wheels", "name": "Wheels" }
  ],

  "rules": {
    "turnOrder": "sides",
    "counterAttacks": true,
    "defeat": ["noUnits", "lostHq"],
    "economy": { "enabled": true },
    "production": { "enabled": true, "builtUnitsCanAct": false },
    "capture": { "enabled": true, "amount": "a.hp / 10" }
  },

  // Damage = chart value (weapon "versus") scaled by attacker health and
  // reduced by 10% per terrain defense star. No hit/crit/strikes: no luck.
  "formulas": {
    "damage": "vs * (a.hp / a.maxhp) * (1 - 0.1 * (tb.defense or 0))"
  },

  "maps": [ { "id": "twin_rivers", "name": "Twin Rivers", "file": "maps/twin_rivers.json" } ]
}
