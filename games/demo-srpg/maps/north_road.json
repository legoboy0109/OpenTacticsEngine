    { "type": "lord",     "side": "blue", "x": 5, "y": 9, "id": "eirik", "name": "Eirik", "level": 3, "leader": true,
      "stats": { "hp": 24, "str": 7, "def": 5 } },
    { "type": "cavalier", "side": "blue", "x": 4, "y": 8, "id": "kell", "name": "Kell", "level": 2,
