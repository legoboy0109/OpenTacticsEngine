  "objectives": {
    "text": "Defeat Hald. Eirik must survive.",
    "win":  [ { "defeated": "hald" } ],
    "lose": [ { "defeated": "eirik" } ]
  },
  "events": [
    // Sera rides with the company only if Eirik won her over at the ford.
    { "id": "sera_arrives", "when": { "battle": "start" },
      "if": [ { "switch": "sera_joined", "is": true } ],
      "do": [ { "addUnit": { "type": "pegasus", "side": "blue", "x": 4, "y": 9, "id": "sera", "name": "Sera", "level": 2 } },
              { "say": "I can cross the stream wherever I like. Tell me where you want me.", "speaker": "sera" } ] },
    { "id": "opening", "when": { "battle": "start" },
      "do": [ { "focus": "hald" },
              { "say": "So Gorm fell. No matter. Nobody takes this pass from me.", "speaker": "hald" } ] },
    { "id": "hald_fights", "when": { "fight": "hald", "with": { "side": "blue" } },
      "do": [ { "say": "Come, then!", "speaker": "hald" } ] }
  ]
