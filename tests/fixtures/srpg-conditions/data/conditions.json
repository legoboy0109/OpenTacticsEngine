{ "conditions": [
  { "id": "poison", "name": "Poison", "description": "Loses a little HP at the start of each of its turns.", "tag": "Po", "turns": 3,
    "blocks": [ { "when": "turnStart", "do": [ { "hurt": { "percent": 10 }, "to": "self" } ] } ] },
  { "id": "sleep", "name": "Sleep", "description": "Cannot act or move. Wakes when struck.", "tag": "Zz", "turns": 3, "endsWhenStruck": true,
    "blocks": [ { "when": "always", "do": [ { "cannotAct": true }, { "cannotMove": true } ] } ] },
  { "id": "silence", "name": "Silence", "description": "Cannot use staves or tomes.", "tag": "Si", "turns": 3,
    "blocks": [ { "when": "always", "do": [ { "forbid": { "kinds": ["staff"], "groups": ["tome"] } } ] } ] },
  { "id": "berserk", "name": "Berserk", "description": "Attacks the nearest unit on its own.", "tag": "Br", "turns": 3,
    "blocks": [ { "when": "always", "do": [ { "berserk": true } ] } ] },
  { "id": "stun", "name": "Stun", "description": "Cannot move, can still act.", "tag": "St", "turns": 2,
    "blocks": [ { "when": "always", "do": [ { "cannotMove": true } ] } ] },
  { "id": "curse", "name": "Curse", "description": "Strength and defense down.", "tag": "Cu", "turns": 3,
    "blocks": [ { "when": "always", "do": [ { "stats": { "str": -2, "def": -2 } } ] } ] },

  { "id": "deadly", "name": "Deadly Poison", "description": "Can kill.", "turns": 3,
    "blocks": [ { "when": "turnStart", "do": [ { "hurt": { "amount": 100, "canKill": true }, "to": "self" } ] } ] },
  { "id": "fever", "name": "Fever", "description": "Loses a flat amount.", "turns": 4,
    "blocks": [ { "when": "turnStart", "do": [ { "hurt": 5, "to": "self" } ] } ] },
  { "id": "formula_burn", "name": "Formula Burn", "description": "Loses HP by a formula.", "turns": 4,
    "blocks": [ { "when": "turnStart", "do": [ { "hurt": { "formula": "a.mag + 1" }, "to": "self" } ] } ] },
  { "id": "regen", "name": "Regen", "description": "Heals each turn.", "turns": 3,
    "blocks": [ { "when": "turnStart", "do": [ { "heal": 4 } ] } ] },
  { "id": "daze", "name": "Daze", "description": "Cannot act but may answer and dodge.", "turns": 2,
    "blocks": [ { "when": "always", "do": [ { "cannotAct": { "counter": true, "dodge": true } } ] } ] },
  { "id": "bless", "name": "Bless", "description": "Strength up, hit and damage up in combat.", "turns": 3,
    "blocks": [ { "when": "always", "do": [ { "stats": { "str": 2 } } ] },
                { "when": "combat", "do": [ { "hit": 5 }, { "damage": 1 } ] } ] },
  { "id": "ember", "name": "Ember", "description": "Burns.", "turns": 2,
    "blocks": [ { "when": "turnStart", "do": [ { "hurt": 2, "to": "self" } ] } ] },
  { "id": "chill", "name": "Chill", "description": "Replaces ember; slows.", "turns": 4, "replaces": ["ember"],
    "blocks": [ { "when": "always", "do": [ { "stats": { "mov": -1 } } ] } ] },
  { "id": "mark", "name": "Mark", "description": "Lasts until cured.", "until": "cured",
    "blocks": [ { "when": "always", "do": [ { "stats": { "def": -1 } } ] } ] },
  { "id": "scar", "name": "Scar", "description": "Lasts until the map ends.", "until": "mapEnd",
    "blocks": [ { "when": "always", "do": [ { "stats": { "str": -1 } } ] } ] },
  { "id": "fleeting", "name": "Fleeting", "description": "May wear off early.", "turns": 5, "wearOff": 99,
    "blocks": [ { "when": "always", "do": [ { "stats": { "def": -1 } } ] } ] },
  { "id": "bind", "name": "Bind", "description": "Cannot move or use items.", "turns": 2,
    "blocks": [ { "when": "always", "do": [ { "cannotMove": true }, { "forbid": { "kinds": ["usable"] } } ] } ] },
  { "id": "rage", "name": "Rage", "description": "Berserk and stronger.", "turns": 2,
    "blocks": [ { "when": "always", "do": [ { "berserk": true } ] }, { "when": "always", "do": [ { "stats": { "str": 3 } } ] } ] } ] }
