{
  "formatVersion": 1, "name": "Combo Fixture",
  "description": "Test game for levels + promotion + merit ranks + class jobs + overlay jobs in one game (docs/JOBS.md, docs/SRPG.md \"Unit ranks\"). Not a demo.",
  "view": { "width": 480, "height": 270, "tileSize": 24 },
  "stats": [ { "id": "hp", "name": "HP" }, { "id": "str", "name": "Strength" }, { "id": "def", "name": "Defense" },
             { "id": "mov", "name": "Move" } ],
  "roles": { "hp": "hp", "move": "mov" },
  "moveTypes": [ { "id": "foot", "name": "Foot" } ],
  "rules": { "defeat": ["noUnits"], "counterAttacks": true,
             "items": { "weapons": "fixed", "inventorySize": 3 },
             "progression": { "enabled": true, "xpPerLevel": 20, "maxLevel": 10, "xpHit": "10", "xpKill": "30" },
             "ranks": { "name": "Merit", "perHit": 5, "perDefeat": 15,
                        "levels": [ { "at": 10, "name": "Veteran", "badge": "I", "bonus": { "str": 1 } },
                                    { "at": 30, "name": "Elite", "badge": "II", "bonus": { "str": 2, "hp": 4 }, "skills": ["steady"] } ] },
             "jobs": { "jp": { "perAction": 10, "perDefeat": 20 },
                       "slots": { "action": 1, "reaction": 1, "support": 1, "movement": 1 },
                       "jpLevels": [20, 60, 120],
                       "changeIn": "camp+prep" } },
  "formulas": { "damage": "math.max(1, a.str + w.might - b.def)", "hit": "100", "strikes": "1" },
  "maps": [ { "id": "first", "name": "First Field", "file": "maps/first.json" },
            { "id": "second", "name": "Second Field", "file": "maps/second.json" },
            { "id": "duel", "name": "Duel", "file": "maps/duel.json" } ]
}
