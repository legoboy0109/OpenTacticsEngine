{ "name": "Field", "grid": { "type": "square", "width": 9, "height": 5 }, "legend": { ".": "plain" },
  "tiles": [ ".........", ".........", ".........", ".........", "........." ],
  "sides": [ { "id": "blue", "name": "Company", "controller": "human" }, { "id": "red", "name": "Raiders", "controller": "ai" } ],
  "structures": [ { "type": "hamlet", "x": 4, "y": 0, "id": "v1", "visitUnits": ["hero", "ally"] },
                  { "type": "chest", "x": 5, "y": 0, "id": "c1", "contents": ["potion"] } ],
  "prep": { "slots": [ { "x": 0, "y": 1 }, { "x": 0, "y": 2 }, { "x": 0, "y": 3 } ], "limit": 2,
            "required": [ { "character": "hero", "slot": 1 } ], "forbidden": [ "rival" ], "fixed": [ "ally" ] },
  "units": [
    { "character": "hero", "side": "blue", "x": 1, "y": 1, "leader": true },
    { "character": "ally", "side": "blue", "x": 1, "y": 3 },
    { "character": "rival", "side": "red", "x": 7, "y": 2, "leader": true, "behaviour": { "mode": "seek", "unit": "hero", "prefer": { "unit": "ally" } } },
    { "type": "grunt", "id": "g1", "side": "red", "x": 7, "y": 1, "behaviour": { "mode": "advance", "prefer": { "unit": "hero" } } },
    { "type": "grunt", "id": "g2", "side": "red", "x": 7, "y": 3, "behaviour": { "mode": "seek", "unit": "hero" } } ],
  "objectives": {
    "win": [ { "defeated": { "unit": "rival" } }, { "reach": { "x": 4, "y": 2, "w": 1, "h": 1 }, "by": "hero" } ],
    "lose": [ { "defeated": "hero" } ] },
  "events": [
    { "id": "e_talk", "when": { "talk": "hero", "to": "ally", "label": "Talk" }, "do": [ { "say": "A word.", "speaker": "hero", "portrait": "hero" }, { "endTurn": true } ] },
    { "id": "e_fight", "when": { "fight": { "unit": "hero" }, "with": { "unit": "rival" } }, "do": [ { "say": "At last.", "speaker": "rival" } ] },
    { "id": "e_dead", "when": { "defeated": { "unit": "hero" }, "by": { "unit": "g1" } }, "do": [ { "win": "red" } ] },
    { "id": "e_by", "when": { "defeated": { "type": "grunt" }, "by": "hero" }, "do": [ { "setSwitch": "met", "to": true } ] },
    { "id": "e_reach", "when": { "reach": { "x": 3, "y": 2, "w": 1, "h": 1 }, "by": { "unit": "hero" } }, "do": [ { "setVariable": "lvl", "level": "hero" } ] },
    { "id": "e_promo", "when": { "promoted": { "unit": "hero" } }, "do": [ { "forgetSkill": "tough", "from": { "unit": "hero" } } ] },
    { "id": "e_visit", "when": { "place": "v1", "is": "visited", "by": "hero" }, "do": [ { "giveItem": "potion", "to": { "unit": "hero" } } ] },
    { "id": "e_start", "when": { "battle": "start" },
      "if": [ { "alive": "hero" }, { "dead": { "unit": "rival" } }, { "sees": "hero", "team": "red" }, { "carries": "potion", "unit": "hero" },
              { "hasSkill": "tough", "unit": { "unit": "hero" } }, { "hasCondition": "poison", "unit": { "unit": "hero" } } ],
      "do": [
        { "addUnit": { "type": "grunt", "id": "g3", "side": "red", "x": 8, "y": 0, "behaviour": { "mode": "seek", "unit": "hero", "prefer": { "unit": "ally" } } } },
        { "moveUnit": "hero", "x": 2, "y": 1 },
        { "removeUnit": { "unit": "g3" } },
        { "changeSide": "ally", "side": "red" },
        { "giveItem": "potion", "to": "hero" },
        { "takeItem": "potion", "from": "hero", "all": true },
        { "setVariable": "lvl", "hp": "hero" },
        { "addVariable": "lvl", "maxHp": "hero" },
        { "setVariable": "lvl", "stat": "str", "of": "hero" },
        { "focus": "hero" },
        { "openChest": "c1", "by": "hero" },
        { "promote": "hero", "to": "veteran" },
        { "teachSkill": "tough", "to": "hero" },
        { "teachSkill": "tough", "to": { "unit": "hero" } },
        { "addCondition": "poison", "to": "hero", "turns": 2 },
        { "addCondition": "poison", "to": { "unit": "hero" } },
        { "removeCondition": "poison", "from": { "unit": "hero" } },
        { "setBehaviour": { "mode": "seek", "unit": "hero", "prefer": { "unit": "ally" } }, "units": { "unit": "g2" } },
        { "choice": "Hold?", "speaker": "hero", "portrait": "hero", "answers": [ { "text": "Yes", "do": [ { "say": "Hold.", "speaker": "hero" } ] }, { "text": "No", "do": [] } ] },
        { "if": [ { "support": ["hero", "ally"], "op": ">=", "value": 1 } ], "then": [ { "addSupport": ["ally", "hero"], "by": 2 } ] } ] },
    { "id": "e_late", "when": { "turn": 2, "side": "red" },
      "do": [ { "addUnit": { "character": "rival", "side": "red", "x": 8, "y": 4, "behaviour": { "mode": "seek", "unit": "hero" } } } ] } ] }
